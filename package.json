{
  "name": "dsh-bili-scroll",
  "version": "0.3.2",
  "description": "DeepSeek Harness 鲸鱼娘：B站评论与私信、真实音画理解、持久记忆和通用任务智能体",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "mcp",
    "duty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jisongmuli/dsh-bili-whale.git"
  },
  "homepage": "https://github.com/jisongmuli/dsh-bili-whale#readme",
  "bugs": {
    "url": "https://github.com/jisongmuli/dsh-bili-whale/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "vendor",
    "README.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE",
    "defaults",
    "scripts",
    "docs",
    "NOTICE.md",
    "安装.cmd",
    "检查环境.cmd",
    "登录模型.cmd",
    "切换模型账号.cmd"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-release.mjs"
  }
}
